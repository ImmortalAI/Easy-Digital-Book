{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Digital Book",
  "version": "../package.json",
  "identifier": "com.immortalai.edb",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Easy Digital Book",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["edb"],
        "mimeType": "application/x-easy-digital-book",
        "name": "Easy Digital Book"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
